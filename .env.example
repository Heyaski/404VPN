POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://vpn:change_me@127.0.0.1:55432/vpn
REDIS_URL=redis://127.0.0.1:6379
BOT_TOKEN=0000000000:get_from_botfather
ROBOKASSA_LOGIN=your_merchant_login
ROBOKASSA_PASSWORD1=xxx
ROBOKASSA_PASSWORD2=xxx
ROBOKASSA_TEST=1
PORT=8080
# Фаза 2: домен для Mini App и API (A-запись → IP сервера). Caddy сам получит сертификат.
DOMAIN=example.ru
MINIAPP_URL=https://example.ru/
# Фаза 3: провижининг пиров WireGuard через API wg-easy.
# Панель слушает только 127.0.0.1 хоста, поэтому core подключается к сети wg-easy
# и обращается к ней по имени контейнера. Имя сети — из
#   docker inspect wg-easy --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
WG_NETWORK=docker-app_default
WG_EASY_URL=http://wg-easy:51821
WG_EASY_PASSWORD=пароль_панели_wg_easy
# Публичный адрес VPN-сервера для поля Endpoint в конфиге (по умолчанию — как отдаёт wg-easy)
WG_ENDPOINT_HOST=195.14.118.198
