{$DOMAIN} {
	encode gzip

	# колбэки Robokassa
	handle /payhook/* {
		reverse_proxy core:8080
	}

	# API админки — матчер длиннее, чем /admin*, поэтому Caddy отдаёт приоритет ему
	handle /admin/api/* {
		reverse_proxy core:8080
	}

	# статика админки: префикс /admin срезается, ассеты лежат в корне /srv/admin
	handle_path /admin* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	# API Mini App и iOS-приложения
	handle /api/* {
		reverse_proxy core:8080
	}

	# статика Mini App (SPA — все прочие пути отдают index.html)
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
