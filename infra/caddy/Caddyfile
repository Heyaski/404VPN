{$DOMAIN} {
	encode gzip

	# колбэки Robokassa
	handle /payhook/* {
		reverse_proxy core:8080
	}

	# API админки — матчер длиннее, чем /admin*, поэтому Caddy отдаёт приоритет ему
	handle /admin/api/* {
		reverse_proxy core:8080
	}

	# статика админки: префикс /admin срезается, ассеты лежат в корне /srv/admin
	handle_path /admin* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	# API Mini App и iOS-приложения
	handle /api/* {
		reverse_proxy core:8080
	}

	# страница /download/ — обычный HTML, БЕЗ Content-Disposition
	@downloadPage path /download /download/
	handle @downloadPage {
		root * /srv/download
		rewrite * /index.html
		file_server
	}

	# сам установщик
	@downloadExe path /download/404VPN-Setup.exe /404VPN-Setup.exe
	handle @downloadExe {
		root * /srv/download
		rewrite * /404VPN-Setup.exe
		header Content-Type "application/octet-stream"
		header Content-Disposition "attachment; filename=\"404VPN-Setup.exe\""
		file_server
	}

	# Android APK
	@downloadApk path /download/404VPN.apk /404VPN.apk
	handle @downloadApk {
		root * /srv/download
		rewrite * /404VPN.apk
		header Content-Type "application/vnd.android.package-archive"
		header Content-Disposition "attachment; filename=\"404VPN.apk\""
		file_server
	}

	# статика Mini App (SPA — все прочие пути отдают index.html)
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
