{$DOMAIN} {
	encode gzip

	# вебхук Robokassa и API Mini App — на core
	handle /payhook/* {
		reverse_proxy core:8080
	}
	handle /api/* {
		reverse_proxy core:8080
	}

	# статика Mini App (SPA — все прочие пути отдают index.html)
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
